  describe("use{{ properCase domainName }}Form", () => {  
    it("should initialize form with correct fields", () => {  
      const { result } = renderHook(  
        () => {  
          const { use{{ properCase domainName }}Form } = use{{ properCase domainName }}();  
          return use{{ properCase domainName }}Form({});  
        },  
        { wrapper },  
      );  

      expect(useForm).toHaveBeenCalledWith({  
        fields: [  
          FORM_FIELD_CONFIG.{{ camelCase domainName }}Name,  
          FORM_FIELD_CONFIG.{{ camelCase domainName }}Type,  
        ],  
        schema: undefined,  
        initialValues: undefined,  
      });  

      expect(result.current).toEqual(defaultMock{{ properCase domainName }}FormData);  
    });  

    it("should initialize form with initial values", () => {  
      const initialValues = {};  

      renderHook(  
        () => {  
          const { use{{ properCase domainName }}Form } = use{{ properCase domainName }}();  
          return use{{ properCase domainName }}Form({ initialValues });  
        },  
        { wrapper },  
      );  

      expect(useForm).toHaveBeenCalledWith(  
        expect.objectContaining({  
          initialValues,  
        }),  
      );  
    });  
  });  

  describe("useGet{{ properCase domainName }}All", () => {  
    const mockParams = { page: 1, limit: 10, search: [], sort: [] };  
    const mockResponse = {  
      data: [  
        { id: 1, name: "{{ properCase domainName }} 1" },  
        { id: 2, name: "{{ properCase domainName }} 2" },  
      ],  
      total: 2,  
    };  

    it("should initialize useGet{{ properCase domainName }}All hook", () => {  
      doMockUseQuery({ data: mockResponse });  

      const { result } = renderHook(  
        () => {  
          const { useGet{{ properCase domainName }}All } = use{{ properCase domainName }}();  
          return useGet{{ properCase domainName }}All(mockParams);  
        },  
        { wrapper },  
      );  

      expect(useQuery).toHaveBeenCalledWith({  
        queryKey: ["{{ camelCase domainName }}s", mockParams],  
        queryFn: expect.any(Function),  
      });  
      expect(result.current.data).toBe(mockResponse);  
    });  

    it("should handle error from API", () => {  
      const mockError = new Error("API Error");  
      doMockUseQuery({ isError: true, error: mockError });  

      const { result } = renderHook(  
        () => {  
          const { useGet{{ properCase domainName }}All } = use{{ properCase domainName }}();  
          return useGet{{ properCase domainName }}All(mockParams);  
        },  
        { wrapper },  
      );  

      expect(result.current.isError).toBe(true);  
      expect(result.current.error).toBe(mockError);  
    });  
  });  

  describe("useGet{{ properCase domainName }}", () => {  
    it("should initialize useGet{{ properCase domainName }} hook", () => {  
      const mockResponse = { id: 1, name: "Test {{ properCase domainName }}" };  
      doMockUseMutation({ data: mockResponse });  

      const { result } = renderHook(  
        () => {  
