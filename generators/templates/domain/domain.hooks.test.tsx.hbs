    it("should handle onSuccess correctly", () => {
      doMockUseMutation({ data: mockDeleteBulkResponse.data });

      renderHook(
        () => {
          const { useDelete{{ properCase domainName }}Bulk } = use{{ properCase domainName }}();
          return useDelete{{ properCase domainName }}Bulk();
