# Run linting on staged files
echo "Running pre-commit checks..."

# Run turbo lint only if there are staged files in apps
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$STAGED_FILES" | grep -q "^apps/"; then
  echo "Running lint checks via Turborepo..."
  bunx turbo run lint --filter='[HEAD]' || {
    echo "Linting failed. Please fix the errors and try again."
    exit 1
  }
fi

echo "Pre-commit checks passed!"
